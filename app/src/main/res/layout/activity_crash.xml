<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#111418">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="24dp"
        android:text="App 崩溃了"
        android:textColor="#EF5350"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:text="请复制下面的错误信息发给开发者，方便定位问题。"
        android:textColor="#9AA5B1"
        android:textSize="13sp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_margin="24dp"
        android:layout_marginTop="12dp"
        android:background="#1E242C"
        android:padding="12dp">

        <TextView
            android:id="@+id/crash_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#E6E6E6"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:textIsSelectable="true" />
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp">

        <Button
            android:id="@+id/crash_copy"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="复制错误信息"
            android:textSize="14sp"
            android:background="@drawable/btn_primary"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/crash_retry"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:text="返回重试"
            android:textSize="14sp"
            android:background="@drawable/btn_secondary"
            android:textColor="#4DA3FF" />
    </LinearLayout>
</LinearLayout>
