<?xml version="1.0" encoding="utf-8"?>
<!-- 首页主机条目：浅色卡片（对齐原版大圆角） -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginTop="8dp"
    android:background="@drawable/bg_host_card"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="14dp"
    android:paddingBottom="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/host_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/cc_ink"
            android:textSize="15sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/host_current"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/current_badge"
            android:textColor="@color/cc_brand"
            android:textSize="11sp"
            android:background="@drawable/bg_host_current"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/host_url"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:textColor="@color/cc_secondary"
        android:textSize="12sp"
        android:singleLine="true"
        android:ellipsize="middle" />
</LinearLayout>
