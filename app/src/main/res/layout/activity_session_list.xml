<?xml version="1.0" encoding="utf-8"?>
<!-- 会话列表页：浅色原版风（白底 + 墨色文字 + 朱红主按钮，与首页统一） -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/cc_bg">

    <!-- 标题栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="12dp">

        <TextView
            android:id="@+id/session_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/app_name"
            android:textColor="@color/cc_ink"
            android:textSize="17sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="end" />

        <Button
            android:id="@+id/session_full"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:text="@string/msg_full_version"
            android:textSize="13sp"
            android:background="@drawable/btn_home_secondary"
            android:textColor="@color/cc_ink" />

        <Button
            android:id="@+id/session_refresh"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginStart="6dp"
            android:text="刷新"
            android:textSize="13sp"
            android:background="@drawable/btn_home_secondary"
            android:textColor="@color/cc_brand" />
    </LinearLayout>

    <!-- 搜索框 -->
    <EditText
        android:id="@+id/session_search"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/url_bg_home"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:textColor="@color/cc_ink"
        android:textColorHint="@color/cc_hint"
        android:textSize="13sp"
        android:singleLine="true"
        android:drawableStart="@drawable/ic_search"
        android:drawablePadding="8dp"
        android:hint="搜索会话…" />

    <!-- 状态行 -->
    <TextView
        android:id="@+id/session_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="8dp"
        android:textSize="12sp"
        android:textColor="@color/cc_secondary" />

    <!-- 会话列表（支持下拉刷新） -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/session_swipe"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/session_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@null"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:clipToPadding="false"
            android:paddingBottom="8dp" />
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!-- 底部按钮：原生新建会话（朱红胶囊） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp">

        <Button
            android:id="@+id/session_new"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="＋ 新建会话"
            android:textSize="15sp"
            android:textStyle="bold"
            android:background="@drawable/btn_home_primary"
            android:textColor="#FFFFFF" />
    </LinearLayout>
</LinearLayout>
