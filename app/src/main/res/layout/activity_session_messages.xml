<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#111418">

    <!-- 标题栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="8dp">

        <TextView
            android:id="@+id/msg_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/app_name"
            android:textColor="#E6E6E6"
            android:textSize="16sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="end" />

        <Button
            android:id="@+id/msg_full"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:text="完整版"
            android:textSize="13sp"
            android:background="@drawable/btn_secondary"
            android:textColor="#E6E6E6" />

        <Button
            android:id="@+id/msg_refresh"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginStart="6dp"
            android:text="刷新"
            android:textSize="13sp"
            android:background="@drawable/btn_secondary"
            android:textColor="#4DA3FF" />
    </LinearLayout>

    <TextView
        android:id="@+id/msg_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp"
        android:textSize="12sp"
        android:textColor="#66707A" />

    <!-- 消息列表（支持下拉刷新） -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/msg_swipe"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/msg_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@null"
            android:transcriptMode="normal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp" />
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!-- 输入区 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="10dp">

        <EditText
            android:id="@+id/msg_input"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/url_bg"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textColor="#E6E6E6"
            android:textColorHint="#66707A"
            android:textSize="14sp"
            android:maxLines="4"
            android:hint="输入消息…" />

        <Button
            android:id="@+id/msg_send"
            android:layout_width="64dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:text="发送"
            android:textSize="14sp"
            android:background="@drawable/btn_primary"
            android:textColor="#FFFFFF" />
    </LinearLayout>
</LinearLayout>
