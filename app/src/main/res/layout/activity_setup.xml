<?xml version="1.0" encoding="utf-8"?>
<!-- 首页（连接设置页）：cc-haha 原版设计语言。
     三段式布局（品牌区 / 列表区独立滚动 / 表单区固定），避免 ListView 嵌套 ScrollView。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/cc_bg">

    <!-- 品牌区：Logo + 标题 + 副标题 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="28dp"
        android:paddingBottom="12dp">

        <ImageView
            android:layout_width="88dp"
            android:layout_height="72dp"
            android:layout_gravity="center_horizontal"
            android:contentDescription="@string/app_name"
            android:src="@drawable/brand_seal" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_gravity="center_horizontal"
            android:text="@string/app_name"
            android:textColor="@color/cc_ink"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_gravity="center_horizontal"
            android:text="@string/setup_subtitle"
            android:textColor="@color/cc_secondary"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- 已保存的电脑地址列表（独立滚动） -->
    <ListView
        android:id="@+id/host_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@null"
        android:listSelector="@android:color/transparent"
        android:clipToPadding="false"
        android:paddingBottom="8dp" />

    <!-- 表单区（固定底部） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="20dp">

        <EditText
            android:id="@+id/setup_url"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/url_bg_home"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:textColor="@color/cc_ink"
            android:textColorHint="@color/cc_hint"
            android:textSize="14sp"
            android:singleLine="true"
            android:inputType="textUri"
            android:imeOptions="actionNext"
            android:hint="@string/url_hint" />

        <EditText
            android:id="@+id/setup_token"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/url_bg_home"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:textColor="@color/cc_ink"
            android:textColorHint="@color/cc_hint"
            android:textSize="14sp"
            android:singleLine="true"
            android:inputType="text"
            android:imeOptions="actionGo"
            android:hint="@string/token_hint" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/setup_add"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:background="@drawable/btn_home_primary"
                android:text="@string/action_connect"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/setup_scan"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:background="@drawable/btn_home_secondary"
                android:text="@string/action_scan"
                android:textColor="@color/cc_brand"
                android:textSize="15sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/setup_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/setup_hint"
            android:textColor="@color/cc_hint"
            android:textSize="12sp"
            android:lineSpacingExtra="4dp" />
    </LinearLayout>
</LinearLayout>
