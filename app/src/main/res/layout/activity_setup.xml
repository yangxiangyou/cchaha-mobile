<?xml version="1.0" encoding="utf-8"?>
<!-- 首页（连接设置页）：cc-haha 原版设计语言——白底、品牌 Logo、浅色表单 -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cc_bg"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp">

        <!-- 品牌区：Logo + 标题 + 副标题（对齐原版空状态排版） -->
        <ImageView
            android:layout_width="98dp"
            android:layout_height="80dp"
            android:layout_marginTop="36dp"
            android:layout_gravity="center_horizontal"
            android:contentDescription="@string/app_name"
            android:src="@drawable/brand_seal" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_gravity="center_horizontal"
            android:text="@string/app_name"
            android:textColor="@color/cc_ink"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_gravity="center_horizontal"
            android:text="@string/setup_subtitle"
            android:textColor="@color/cc_secondary"
            android:textSize="13sp" />

        <!-- 已保存的电脑地址列表 -->
        <ListView
            android:id="@+id/host_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:divider="@null"
            android:listSelector="@android:color/transparent" />

        <!-- 底部表单 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical">

            <EditText
                android:id="@+id/setup_url"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/url_bg_home"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:textColor="@color/cc_ink"
                android:textColorHint="@color/cc_hint"
                android:textSize="14sp"
                android:singleLine="true"
                android:inputType="textUri"
                android:imeOptions="actionNext"
                android:hint="@string/url_hint" />

            <EditText
                android:id="@+id/setup_token"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/url_bg_home"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:textColor="@color/cc_ink"
                android:textColorHint="@color/cc_hint"
                android:textSize="14sp"
                android:singleLine="true"
                android:inputType="text"
                android:imeOptions="actionGo"
                android:hint="@string/token_hint" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/setup_add"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:background="@drawable/btn_home_primary"
                    android:text="@string/action_connect"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/setup_scan"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/btn_home_secondary"
                    android:text="@string/action_scan"
                    android:textColor="@color/cc_brand"
                    android:textSize="15sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/setup_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/setup_hint"
                android:textColor="@color/cc_hint"
                android:textSize="12sp"
                android:lineSpacingExtra="4dp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
